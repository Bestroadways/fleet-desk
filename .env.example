# ---- Copy this file to ".env" (same folder). Everything below is optional for running on your own computer. ----
PORT=8080
APP_URL=http://localhost:8080
DATA_DIR=./data
FILE_SECRET=change-me-long-random

# ---- On the Linux VPS use these instead (uncomment, edit) ----
# APP_URL=https://fleet.bestroadways.com
# DATA_DIR=/opt/fleet-desk/data

# ---- Google Sheets (only for "npm run import" and the sheet backup) ----
# GOOGLE_KEY_FILE=/opt/fleet-desk/service-account.json
# SOURCE_SHEET_ID=1dkHTWTGa-SZ_w7R6ydybSFIKLkPcVccsIy6KnsLUpF0
# BACKUP_SHEET_ID=

# ---- Mail from fms@ (leave empty = mails are skipped) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=fms@bestroadways.com
# SMTP_PASS=
# MAIL_FROM=fms@bestroadways.com

# ---- GTropy + e-Fleet ERP (leave empty = fetchers are skipped) ----
# GTROPY_CLIENT_ID=
# GTROPY_CLIENT_SECRET=
# API_HEADERS={"Authorization":"Sync ..."}
